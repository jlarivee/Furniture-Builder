# API Keys (Required)
# Get Anthropic API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Get OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# Get Unsplash API key from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
# Get Pexels API key from: https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS) - Not needed in Replit
FRONTEND_URL=http://localhost:5173

# REPLIT USERS: Use Replit Secrets instead of this .env file
# In your Repl, go to the Secrets tab (lock icon in left sidebar)
# Add these secrets:
# - ANTHROPIC_API_KEY: your Anthropic API key
# - OPENAI_API_KEY: your OpenAI API key
# - UNSPLASH_ACCESS_KEY: your Unsplash API key (optional, for furniture photo browser)
# - PEXELS_API_KEY: your Pexels API key (optional, for furniture photo browser)
